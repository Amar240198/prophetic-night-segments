API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

# Google Calendar OAuth: server-side only. See docs/google-calendar-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
# Generate with: openssl rand -base64 32
GOOGLE_SESSION_SECRET=
# Set true during a schema migration to fence all Google Calendar writes.
CALENDAR_MUTATIONS_PAUSED=false
# Optional server-only ownership key ring: {"active":"key-id","keys":{"key-id":"base64-32-byte-secret"}}
# Defaults to GOOGLE_SESSION_SECRET as session-v1. Retain historical keys; see the sync guide.
CALENDAR_OWNERSHIP_KEYS=

# Neon PostgreSQL, server-side only. Apply migrations 001–011 in order before deployment.
DATABASE_URL=

# Fail closed. Enable only after read-only production acceptance and explicit approval.
CALENDAR_WRITES_ENABLED=false
GOOGLE_CALENDAR_ENABLED=true
MIQAT_CONFLICT_ENGINE_ENABLED=true
MIQAT_RECOMMENDATIONS_ENABLED=true
# Apply migrations 001–011 in order. Existing GOOGLE_SESSION_SECRET encrypts tokens.

# SaaS billing. Hosted Checkout does not require a browser publishable key.
APP_ORIGIN=http://localhost:3000
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
# Live financial activation requires a separate owner-approved acceptance gate.
STRIPE_LIVE_ENABLED=false
# SMTP password-reset delivery (server only). No vendor is required by the app.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
