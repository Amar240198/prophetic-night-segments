API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

# Google Calendar OAuth: server-side only. See docs/google-calendar-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
# Generate with: openssl rand -base64 32
GOOGLE_SESSION_SECRET=
# Optional server-only ownership key ring: {"active":"key-id","keys":{"key-id":"base64-32-byte-secret"}}
# Defaults to GOOGLE_SESSION_SECRET as session-v1. Retain historical keys; see the sync guide.
CALENDAR_OWNERSHIP_KEYS=

# Neon PostgreSQL, server-side only. Apply migrations 001–004 in order before deployment.
DATABASE_URL=
